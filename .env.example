# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_MODELS: lista (separada por comas) de modelos a rotar para repartir la cuota gratuita.
# Por defecto: gemini-3.1-flash-lite,gemini-3.5-flash-lite
# GEMINI_MODELS="gemini-3.1-flash-lite,gemini-3.5-flash-lite"

# GEMINI_DAILY_LIMIT: tope local de solicitudes por modelo y dia (por defecto 20).
# GEMINI_DAILY_LIMIT=20



# --- Proveedores gratuitos de apoyo (solo servidor; ponlos en .env.local, que git ignora) ---
# GROQ_API_KEY alimenta la tarjeta Meta AI (Llama servido por Groq). Opcional: GROQ_MODEL (por defecto llama-3.3-70b-versatile).
# GROQ_API_KEY=
# OPENROUTER_API_KEY es el respaldo automatico de Gemini cuando se agota su cuota. Opcional: OPENROUTER_MODEL (por defecto google/gemma-4-31b-it:free).
# OPENROUTER_API_KEY=
# PROVIDER_DAILY_LIMIT: tope local de solicitudes por proveedor y dia (por defecto 200).
